# =============================================================================
# PSKloud Prospector - Variables de Entorno
# Copia este archivo como .env y rellena tus valores
# =============================================================================

# --- Gemini API (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=TU_KEY_AQUI

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=TU_EVO_KEY_AQUI
EVOLUTION_INSTANCE=pskloud-prospector

# --- PostgreSQL (para Evolution API) ---
POSTGRES_DB=evolution_db
POSTGRES_USER=evolution
POSTGRES_PASSWORD=CAMBIA_ESTE_PASSWORD

# --- OpenClaw Queue ---
MAX_DAILY_OUTBOUND=10
MIN_DELAY_SECONDS=180
MAX_DELAY_SECONDS=480
TYPING_DELAY_MIN_MS=3000
TYPING_DELAY_MAX_MS=5000
HOUR_START=8
HOUR_END=18
WORK_DAYS=0,1,2,3,4
MAX_PER_COUNTRY_DAILY=20

# --- Handoff (tu WhatsApp personal para alertas) ---
HANDOFF_PHONE=5070000000

# --- Mensajes (personaliza segun tu negocio) ---
MSG_SALUDO=Buenos dias, senores de {nombre_empresa}, un gusto saludarles.
MSG_CALIFICACION=Queria consultarles brevemente: actualmente disponen de un software administrativo, contable y de control de inventario/POS que cumpla con las exigencias de ley?
MSG_PRESENTACION=Pertenezco a la casa Premium-Soft creadora del software administrativo y contable disenado para adaptarse a todas las normativas de ley y facturacion electronica. Si tienes un espacio de tiempo esta semana, podemos agendar una llamada o videollamada para una demostracion en vivo de la suite y conversar sobre como podemos apoyarte con la migracion y nuestros planes flexibles.
